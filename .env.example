# ==========================================
# Konfigurasi Lingkungan Garuda CBT Docker
# ==========================================

# Port web utama aplikasi (contoh: buka di http://localhost:8080)
APP_PORT=8080

# Port phpMyAdmin (contoh: buka di http://localhost:8081)
PMA_PORT=8081

# Port MySQL/MariaDB eksternal (jika ingin diakses dari DBeaver / Navicat / HeidiSQL)
DB_PORT=3306

# Kredensial Database
DB_NAME=garudacbt
DB_USER=garudacbt
DB_PASSWORD=garuda123
DB_ROOT_PASSWORD=rootsecret

# Zona Waktu (Asia/Jakarta, Asia/Makassar, Asia/Jayapura)
TIMEZONE=Asia/Jakarta
